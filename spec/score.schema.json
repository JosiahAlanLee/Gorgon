{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JosiahAlanLee/Gorgon/spec/score.schema.json",
  "title": "Gorgon tracker score (versions 1, 2 and 3)",
  "description": "The score document exchanged between the tracker editor, HydraPy Studio and bridge followers such as the VCV Rack module. Normative reference: spec/score.md (versions 1 and 2) and spec/score-v3.md, spec/evaluator.md and spec/transforms.md (version 3, not yet implemented). Validation in the reference implementation: hydrapy/studio_tracker.py validate().",
  "oneOf": [
    {
      "$ref": "#/$defs/scoreV1V2"
    },
    {
      "$ref": "#/$defs/scoreV3"
    }
  ],
  "$defs": {
    "output": {
      "enum": [
        "o0",
        "o1",
        "o2",
        "o3"
      ]
    },
    "controlName": {
      "type": "string",
      "maxLength": 120
    },
    "row": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63,
      "description": "Sixteenth-note row within the pattern."
    },
    "note": {
      "type": "string",
      "pattern": "^(([A-G]-?|[ACDFG]#)[0-8]|([C-G]-?|[CDF]#)9|AIR)$",
      "description": "C0-G9 with an optional separator or sharp: 'C-4' and 'C4' both mean MIDI 60; 'D#4' is MIDI 63. B# and E# are rejected, as is anything above G9 (MIDI 127). 'AIR' is an unpitched event: it opens a gate and updates velocity but leaves the held pitch unchanged."
    },
    "hit": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "note",
        "vel"
      ],
      "additionalProperties": true,
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        },
        "vel": {
          "type": "number",
          "minimum": 0,
          "maximum": 127,
          "description": "Velocity 0-127. Zero is silent: no gate, no hit, held values unchanged."
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    },
    "easing": {
      "enum": [
        "hold",
        "linear",
        "smooth"
      ],
      "description": "Interpolation between automation keys: step at the key row, linear, or smoothstep (t*t*(3-2t))."
    },
    "pattern": {
      "type": "object",
      "required": [
        "name",
        "audio",
        "keys",
        "easing"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "audio": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 64,
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/hit"
            }
          },
          "description": "Four audio lanes of 64 cells; null is an empty cell."
        },
        "keys": {
          "type": "object",
          "required": [
            "z",
            "roll",
            "feedback"
          ],
          "additionalProperties": false,
          "properties": {
            "z": {
              "$ref": "#/$defs/keysZ"
            },
            "roll": {
              "$ref": "#/$defs/keysRoll"
            },
            "feedback": {
              "$ref": "#/$defs/keysFeedback"
            }
          },
          "description": "Automation keys per lane, sorted by row with unique rows, at most 64 per lane. Lane ranges: z 0-1 (default 0.35), roll -45-45 degrees (default 0), feedback 0-0.9 (default 0.25)."
        },
        "easing": {
          "type": "object",
          "required": [
            "z",
            "roll",
            "feedback"
          ],
          "properties": {
            "z": {
              "$ref": "#/$defs/easing"
            },
            "roll": {
              "$ref": "#/$defs/easing"
            },
            "feedback": {
              "$ref": "#/$defs/easing"
            }
          }
        },
        "scenes": {
          "type": "array",
          "maxItems": 64,
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "r",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "r": {
                "$ref": "#/$defs/row"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,24}$",
                "description": "A scene the patch declares. A name the patch does not declare is kept in the score and ignored when playing."
              },
              "fade": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64,
                "default": 0,
                "description": "Crossfade length in rows from the previous scene on the same output. Clipped to the gap before the next change."
              }
            }
          },
          "description": "Scene changes, sorted by row with unique rows. Optional: scores saved before scenes existed load unchanged. Visual side only; CV followers ignore this field."
        }
      }
    },
    "keysZ": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "r",
          "v"
        ],
        "properties": {
          "r": {
            "$ref": "#/$defs/row"
          },
          "v": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "keysRoll": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "r",
          "v"
        ],
        "properties": {
          "r": {
            "$ref": "#/$defs/row"
          },
          "v": {
            "type": "number",
            "minimum": -45,
            "maximum": 45
          }
        }
      }
    },
    "keysFeedback": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "r",
          "v"
        ],
        "properties": {
          "r": {
            "$ref": "#/$defs/row"
          },
          "v": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.9
          }
        }
      }
    },
    "soundParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p3": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p4": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p5": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p6": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p7": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p8": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "sound": {
      "type": "object",
      "required": [
        "machine",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "machine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 191
        },
        "params": {
          "$ref": "#/$defs/soundParams"
        }
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p3": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p4": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p5": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p6": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p7": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "p8": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "machine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 191
        }
      }
    },
    "row3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127,
      "description": "Row within a version-3 pattern, below the pattern's bar * bars (checked in code)."
    },
    "keysZ3": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "r",
          "v"
        ],
        "properties": {
          "r": {
            "$ref": "#/$defs/row3"
          },
          "v": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "keysRoll3": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "r",
          "v"
        ],
        "properties": {
          "r": {
            "$ref": "#/$defs/row3"
          },
          "v": {
            "type": "number",
            "minimum": -45,
            "maximum": 45
          }
        }
      }
    },
    "keysFeedback3": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "r",
          "v"
        ],
        "properties": {
          "r": {
            "$ref": "#/$defs/row3"
          },
          "v": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.9
          }
        }
      }
    },
    "lane3": {
      "type": "object",
      "required": [
        "len",
        "cells",
        "transforms"
      ],
      "properties": {
        "len": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "The lane repeats every len rows; at most the pattern's rows (checked in code)."
        },
        "cells": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/hit3"
          },
          "description": "Exactly len cells (checked in code); null is an empty cell."
        },
        "transforms": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/transform3"
          },
          "description": "Lane transforms (spec/transforms.md), applied in order; [] for none. The product of every ply's n in the list, including inside every, is at most 4 (checked in code)."
        }
      }
    },
    "pattern3": {
      "type": "object",
      "required": [
        "name",
        "rate",
        "bar",
        "bars",
        "lanes",
        "keys",
        "easing"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "rate": {
          "type": "number",
          "enum": [
            0.25,
            0.5,
            1,
            2,
            4,
            8
          ],
          "description": "Rows per quarter note = 4 * rate."
        },
        "bar": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Rows per bar."
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Bars per pattern; rows = bar * bars, at most 128 (checked in code)."
        },
        "lanes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/lane3"
          }
        },
        "keys": {
          "type": "object",
          "required": [
            "z",
            "roll",
            "feedback"
          ],
          "additionalProperties": false,
          "properties": {
            "z": {
              "$ref": "#/$defs/keysZ3"
            },
            "roll": {
              "$ref": "#/$defs/keysRoll3"
            },
            "feedback": {
              "$ref": "#/$defs/keysFeedback3"
            }
          },
          "description": "Automation keys per lane, sorted by row with unique rows, at most 128 per lane, rows below the pattern's rows. Lane ranges: z 0-1 (default 0.35), roll -45-45 degrees (default 0), feedback 0-0.9 (default 0.25)."
        },
        "easing": {
          "type": "object",
          "required": [
            "z",
            "roll",
            "feedback"
          ],
          "properties": {
            "z": {
              "$ref": "#/$defs/easing"
            },
            "roll": {
              "$ref": "#/$defs/easing"
            },
            "feedback": {
              "$ref": "#/$defs/easing"
            }
          }
        },
        "scenes": {
          "type": "array",
          "maxItems": 128,
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "r",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "r": {
                "$ref": "#/$defs/row3"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,24}$",
                "description": "A scene the patch declares. A name the patch does not declare is kept in the score and ignored when playing."
              },
              "fade": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128,
                "default": 0,
                "description": "Crossfade length in rows from the previous scene on the same output. Clipped to the gap before the next change."
              }
            }
          },
          "description": "Scene changes, sorted by row with unique rows. Optional: scores saved before scenes existed load unchanged. Visual side only; CV followers ignore this field."
        }
      }
    },
    "scoreV1V2": {
      "type": "object",
      "required": [
        "format",
        "bpm",
        "key",
        "pattern",
        "loop",
        "sound",
        "mutes",
        "modes",
        "bindings",
        "patterns"
      ],
      "properties": {
        "format": {
          "enum": [
            "hydrapy-tracker-1",
            "hydrapy-tracker-2"
          ]
        },
        "bpm": {
          "type": "number",
          "minimum": 60,
          "maximum": 200,
          "description": "Quarter notes per minute. A row is a sixteenth."
        },
        "key": {
          "enum": [
            0,
            2,
            5,
            7
          ],
          "description": "Semitone of the key's root: C, D, F or G. Pitched notes are transposed by key - 2 (D is the reference key)."
        },
        "pattern": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "The selected pattern; the one that plays when loop is true."
        },
        "loop": {
          "type": "boolean",
          "description": "true: cycle the selected pattern (16 beats). false: cycle all four patterns in order (64 beats)."
        },
        "sound": {
          "type": "boolean",
          "description": "Browser audition synth on/off. Editor state; followers ignore it."
        },
        "mutes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "boolean"
          },
          "description": "One per audio lane. A muted lane sends no gates or hits and does not update its held pitch or velocity."
        },
        "modes": {
          "type": "object",
          "required": [
            "program",
            "aux"
          ],
          "additionalProperties": false,
          "properties": {
            "program": {
              "$ref": "#/$defs/output"
            },
            "aux": {
              "$ref": "#/$defs/output"
            }
          },
          "description": "Which Studio output each monitor shows. Program also selects Studio's displayed/recorded output."
        },
        "bindings": {
          "type": "object",
          "required": [
            "z",
            "roll",
            "feedback"
          ],
          "additionalProperties": false,
          "properties": {
            "z": {
              "$ref": "#/$defs/controlName"
            },
            "roll": {
              "$ref": "#/$defs/controlName"
            },
            "feedback": {
              "$ref": "#/$defs/controlName"
            }
          },
          "description": "The patch control each automation lane drives, by name. An empty string disconnects the lane. Non-empty names must be distinct."
        },
        "patterns": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "sounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/sound"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "hydrapy-tracker-2"
              }
            }
          },
          "then": {
            "required": [
              "sounds"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sounds"
                  ]
                },
                {
                  "properties": {
                    "patterns": {
                      "contains": {
                        "properties": {
                          "audio": {
                            "contains": {
                              "contains": {
                                "type": "object",
                                "required": [
                                  "locks"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "scoreV3": {
      "type": "object",
      "required": [
        "format",
        "bpm",
        "key",
        "pattern",
        "loop",
        "chain",
        "seed",
        "sound",
        "mutes",
        "lanes",
        "modes",
        "bindings",
        "sounds",
        "patterns"
      ],
      "properties": {
        "format": {
          "const": "hydrapy-tracker-3"
        },
        "bpm": {
          "type": "number",
          "minimum": 60,
          "maximum": 200,
          "description": "Quarter notes per minute. A row is a sixteenth."
        },
        "key": {
          "enum": [
            0,
            2,
            5,
            7
          ],
          "description": "Semitone of the key's root: C, D, F or G. Pitched notes are transposed by key - 2 (D is the reference key)."
        },
        "pattern": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "The selected pattern, bank * 16 + number - 1 (A01 = 0, H16 = 127); the one that plays when loop is true."
        },
        "loop": {
          "type": "boolean",
          "description": "true: the selected pattern repeats. false: the chain plays."
        },
        "chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "description": "The song order: pattern indices played in turn when loop is false. Repeats allowed."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Drives every probability condition (spec/evaluator.md). Migrated scores use 0."
        },
        "sound": {
          "type": "boolean",
          "description": "Browser audition synth on/off. Editor state; followers ignore it."
        },
        "mutes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "boolean"
          },
          "description": "One per lane. A muted lane sends no gates or hits and does not update its held pitch or velocity."
        },
        "lanes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 24
              }
            }
          },
          "description": "Six lanes, one per Monomachine track. Display names."
        },
        "modes": {
          "type": "object",
          "required": [
            "program",
            "aux"
          ],
          "additionalProperties": false,
          "properties": {
            "program": {
              "$ref": "#/$defs/output"
            },
            "aux": {
              "$ref": "#/$defs/output"
            }
          },
          "description": "Which Studio output each monitor shows. Program also selects Studio's displayed/recorded output."
        },
        "bindings": {
          "type": "object",
          "required": [
            "z",
            "roll",
            "feedback"
          ],
          "additionalProperties": false,
          "properties": {
            "z": {
              "$ref": "#/$defs/controlName"
            },
            "roll": {
              "$ref": "#/$defs/controlName"
            },
            "feedback": {
              "$ref": "#/$defs/controlName"
            }
          },
          "description": "The patch control each automation lane drives, by name. An empty string disconnects the lane. Non-empty names must be distinct."
        },
        "sounds": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/sound"
          }
        },
        "patterns": {
          "type": "array",
          "minItems": 128,
          "maxItems": 128,
          "items": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/pattern3"
              }
            ]
          },
          "description": "Eight banks of sixteen. null is an empty pattern: rate 1, bar 16, bars 4, empty lanes of 64 rows."
        }
      }
    },
    "cond": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "every",
            "prob",
            "fill",
            "first"
          ]
        },
        "a": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "b": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "p": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "not": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "every"
              }
            }
          },
          "then": {
            "required": [
              "a",
              "b"
            ],
            "not": {
              "required": [
                "p"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "a"
                  ]
                },
                {
                  "required": [
                    "b"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "prob"
              }
            }
          },
          "then": {
            "required": [
              "p"
            ]
          },
          "else": {
            "not": {
              "required": [
                "p"
              ]
            }
          }
        }
      ],
      "description": "A cell condition (spec/evaluator.md): every a:b (a <= b, checked in code), prob %p, fill F, first 1ST; not negates. Fields other than the kind's are rejected."
    },
    "hit3": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "note",
        "vel"
      ],
      "additionalProperties": true,
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        },
        "vel": {
          "type": "number",
          "minimum": 0,
          "maximum": 127,
          "description": "Velocity 0-127. Zero is silent: no gate, no hit, held values unchanged."
        },
        "locks": {
          "$ref": "#/$defs/locks"
        },
        "cond": {
          "$ref": "#/$defs/cond"
        },
        "len": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 16
        }
      },
      "description": "A version-3 cell: null, or note and velocity with optional len (0.25–16 base rows), locks and cond."
    },
    "transformLeaf": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rot",
            "rev",
            "ply",
            "degrade"
          ]
        },
        "k": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127
        },
        "n": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "p": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rot"
              }
            }
          },
          "then": {
            "required": [
              "k"
            ]
          },
          "else": {
            "not": {
              "required": [
                "k"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ply"
              }
            }
          },
          "then": {
            "required": [
              "n"
            ]
          },
          "else": {
            "not": {
              "required": [
                "n"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "degrade"
              }
            }
          },
          "then": {
            "required": [
              "p"
            ]
          },
          "else": {
            "not": {
              "required": [
                "p"
              ]
            }
          }
        }
      ],
      "description": "A transform without children: rot k (cells move k lane rows later), rev, ply n (each event becomes n within its row), degrade p (each event kept with probability p%). Fields other than the kind's are rejected."
    },
    "transformEvery2": {
      "type": "object",
      "required": [
        "kind",
        "a",
        "b",
        "inner"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "every"
        },
        "a": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "b": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "inner": {
          "$ref": "#/$defs/transformLeaf"
        }
      },
      "description": "every a:b applies inner on bars where bar_count mod b = a - 1, the a:b condition's test (a <= b, checked in code). Depth 2."
    },
    "transform2": {
      "anyOf": [
        {
          "$ref": "#/$defs/transformLeaf"
        },
        {
          "$ref": "#/$defs/transformEvery2"
        }
      ],
      "description": "A transform of depth at most 2."
    },
    "transformEvery3": {
      "type": "object",
      "required": [
        "kind",
        "a",
        "b",
        "inner"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "every"
        },
        "a": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "b": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "inner": {
          "$ref": "#/$defs/transform2"
        }
      },
      "description": "every a:b applies inner on bars where bar_count mod b = a - 1, the a:b condition's test (a <= b, checked in code). Depth 3."
    },
    "transform3": {
      "anyOf": [
        {
          "$ref": "#/$defs/transformLeaf"
        },
        {
          "$ref": "#/$defs/transformEvery3"
        }
      ],
      "description": "A transform of depth at most 3: every may hold every, which holds a leaf."
    }
  },
  "x-notes": [
    "Unknown top-level and pattern-level keys are tolerated and preserved by the reference implementation (the shipped demo score carries 'version' and 'scene'); implementations must ignore keys they do not know.",
    "Row ordering (sorted, unique) within keys and scenes cannot be expressed in JSON Schema; validate it in code.",
    "Non-finite numbers (NaN, Infinity) are rejected everywhere a number is accepted.",
    "Version 3 (proposed, spec/score-v3.md): bar * bars <= 128, each lane's len <= rows with exactly len cells, and key and scene rows below rows cannot be expressed in JSON Schema; validate them in code. A condition's a <= b is checked in code. Transforms and bus fields are added by later spec PRs."
  ]
}
